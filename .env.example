# n8n Webhook (Platzhalter — echte Werte nur lokal / in n8n setzen)
N8N_WEBHOOK_URL=https://N8N_HOST_PLACEHOLDER/webhook/einwilligung-bildnutzung
# Optional: leer lassen wenn n8n-Webhook-Auth = None (Exporter sendet dann keinen X-Webhook-Secret-Header)
N8N_WEBHOOK_SECRET=

# Absoluter Pfad zum Repo — NUR Alternative zu SYNC_ROOT in der .js, und nur wenn
# die Variable für den Jameica-Prozess gilt (Windows System/User-ENV oder Shortcut).
# Eine Shell-.env hier reicht NICHT für das Scripting-Hook. Empfehlung: SYNC_ROOT in der .js.
# OPENJVEREIN_N8N_SYNC_ROOT=/path/to/openjverein-n8n-sync

# Optional: Jameica-Installationsverzeichnis (hilft bei Auto-Discovery der h2-*.jar)
# Windows-Beispiel (Platzhalter — lokalen Pfad nur in .env, nie committen):
# JAMEICA_HOME=C:\path\to\jameica
# JAMEICA_HOME=/path/to/jameica

# H2-Datenbank (nach Jameica-Exit readonly öffnen)
# Pfad ZUR Datei OHNE Suffix .mv.db / .h2.db / .db
# Typisch unter dem Jameica-Workdir (.jameica), nicht unter dem Programm-Ordner:
#   Windows: %USERPROFILE%\.jameica\openjverein\h2db\openjverein
#            (ältere Installationen: …\.jameica\jverein\h2db\jverein)
#   Linux:   ~/.jameica/openjverein/h2db/openjverein
# Suche: Explorer/PowerShell → %USERPROFILE%\.jameica → openjverein|jverein → h2db
#        → Datei openjverein.mv.db (oder .h2.db) → H2_DB_PATH = gleicher Pfad ohne Suffix
H2_DB_PATH=/path/to/.jameica/openjverein/h2db/openjverein
H2_USER=sa
H2_PASSWORD=

# H2-JDBC-JAR (org.h2.Driver). Expliziter Pfad empfohlen; sonst Auto-Discovery:
#   JAMEICA_HOME\lib\h2\h2-*.jar  bzw.  lib\h2\migration-h2\disabled\h2-*.jar
#   %USERPROFILE%\.jameica\plugins\**\h2-*.jar
#   Program Files\jameica*\lib\h2\…
# Windows-Suche: in Jameica-Programmordner + .jameica nach Dateiname h2-*.jar
# Persönliche Absolutpfade nur in lokaler .env — nicht committen.
H2_JDBC_JAR=/path/to/h2-2.x.x.jar

# Arbeitsverzeichnisse relativ zum Repo-Root (oder absolute Pfade)
OUTPUT_DIR=./output
OUTBOX_DIR=./outbox

# Sekunden warten nach Jameica-Exit, bevor H2 geöffnet wird
EXIT_H2_SETTLE_SECONDS=2
# Max. Sekunden auf Jameica-PID warten (export-trigger exit <pid>); danach Export trotzdem
# EXIT_PID_WAIT_SECONDS=600

# Webhook-Timeout (Sekunden). Manueller Outbox-Flush (export-trigger start) setzt kurz (8).
# N8N_HTTP_TIMEOUT_SECONDS=60

# H2 JDBC connect / query ceilings (Sekunden). Avoid infinite hang on locked H2 / JVM.
# H2_CONNECT_TIMEOUT_SECONDS=30
# H2_QUERY_TIMEOUT_SECONDS=60
# Whole exporter run watchdog (writes exporter-fail reason=watchdog then hard-exits)
# EXPORTER_WATCHDOG_SECONDS=180

# Optional / Notfall: nur wenn jemand den cancelled Launcher experimentell nutzt
# JAMEICA_BIN=/path/to/jameica/jameica.sh
# FLUSH_OUTBOX_ON_START=0
