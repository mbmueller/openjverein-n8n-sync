# n8n Webhook (Platzhalter — echte Werte nur lokal / in n8n setzen)
N8N_WEBHOOK_URL=https://N8N_HOST_PLACEHOLDER/webhook/einwilligung-bildnutzung
N8N_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# Jameica / OpenJVerein
# Pfad zur Jameica-Startskript bzw. ausführbaren Datei
JAMEICA_BIN=/path/to/jameica/jameica.sh

# H2-Datenbank (nach Jameica-Exit readonly öffnen)
# Typischer Jameica-Home + OpenJVerein-DB — an lokale Installation anpassen
H2_DB_PATH=/path/to/jameica/plugins/openjverein/h2db/openjverein
H2_USER=sa
H2_PASSWORD=

# Optional: Pfad zur H2-JDBC-JAR (liegt oft bei Jameica/OpenJVerein)
H2_JDBC_JAR=/path/to/h2-2.x.x.jar

# Arbeitsverzeichnisse relativ zum Repo-Root (oder absolute Pfade)
OUTPUT_DIR=./output
OUTBOX_DIR=./outbox

# Optional: nach Start nur Outbox flushen (1=ja, 0=nein)
FLUSH_OUTBOX_ON_START=1
