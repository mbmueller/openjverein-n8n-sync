    {
      "parameters": {
        "jsCode": "const raw = items[0].json;\nconst body = raw.body && typeof raw.body === 'object' ? raw.body : raw;\n\nif (!body || typeof body !== 'object') {\n  throw new Error('Payload fehlt');\n}\nif (!Array.isArray(body.members)) {\n  throw new Error('members muss ein Array sein');\n}\nif (!Array.isArray(body.fields)) {\n  throw new Error('fields muss ein Array sein');\n}\n\nconst requiredFields = ['insta', 'website', 'flyer'];\nfor (const f of requiredFields) {\n  if (!body.fields.includes(f)) {\n    throw new Error(`Feld ${f} fehlt in fields`);\n  }\n}\n\nconst asBool = (v) => {\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0 || v == null) return false;\n  const s = String(v).trim().toLowerCase();\n  if (['ja', 'true', '1', 'yes'].includes(s)) return true;\n  if (['nein', 'false', '0', 'no', ''].includes(s)) return false;\n  return Boolean(v);\n};\n\n// Sicherheitsnetz: ≥1 Einwilligung (Exporter filtert bereits aktiv + ≥1)\nconst members = body.members\n  .filter((m) => m && typeof m === 'object')\n  .map((m) => ({\n    id: m.id,\n    mitgliedsnummer: m.mitgliedsnummer ?? '',\n    name: m.name ?? '',\n    vorname: m.vorname ?? '',\n    insta: asBool(m.insta),\n    website: asBool(m.website),\n    flyer: asBool(m.flyer),\n  }))\n  .filter((m) => m.insta || m.website || m.flyer);\n\nconst exportedAt = body.exported_at || new Date().toISOString();\nconst day = String(exportedAt).slice(0, 10);\n\nconst payload = {\n  exported_at: exportedAt,\n  source: body.source || 'openjverein',\n  trigger: body.trigger || 'unknown',\n  fields: body.fields,\n  members,\n};\n\nconst csvHeader = 'id,mitgliedsnummer,name,vorname,insta,website,flyer\\n';\nconst esc = (s) => `\"${String(s ?? '').replace(/\"/g, '\"\"')}\"`;\nconst yn = (v) => (v ? 'Ja' : 'Nein');\nconst csvRows = members\n  .map((m) =>\n    [m.id, esc(m.mitgliedsnummer), esc(m.name), esc(m.vorname), yn(m.insta), yn(m.website), yn(m.flyer)].join(','),\n  )\n  .join('\\n');\n\nconst meta = {\n  last_sync_at: exportedAt,\n  source: payload.source,\n  trigger: payload.trigger,\n  member_count: members.length,\n};\n\nreturn [{\n  json: {\n    payload,\n    meta,\n    archiveDay: day,\n    jsonName: 'einwilligungen.json',\n    csvName: 'einwilligungen.csv',\n    metaName: 'last-sync.json',\n    jsonContent: JSON.stringify(payload, null, 2),\n    csvContent: csvHeader + csvRows + (csvRows ? '\\n' : ''),\n    metaContent: JSON.stringify(meta, null, 2),\n  },\n}];"
      },
